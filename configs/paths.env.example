# Copy to configs/paths.env and replace the checkpoint placeholders.
# Only the paths for the model you run are required.
# Environment variables exported by the caller take precedence.
export QUANTWM_PYTHON="${QUANTWM_PYTHON:-python}"
export MATRIX_MODEL_PATH="${MATRIX_MODEL_PATH:-/path/to/Matrix-Game-2.0}"
export LINGBOT_MODEL_PATH="${LINGBOT_MODEL_PATH:-/path/to/lingbot-world-v2-14b-causal-fast}"
export HY_MODEL_ID="${HY_MODEL_ID:-/path/to/Wan2.2-TI2V-5B-Diffusers}"
export HY_AR_MODEL_PATH="${HY_AR_MODEL_PATH:-/path/to/HY-WorldPlay/wan_transformer}"
export HY_CHECKPOINT_PATH="${HY_CHECKPOINT_PATH:-/path/to/HY-WorldPlay/wan_distilled_model/model.pt}"
export SELF_FORCING_CHECKPOINT="${SELF_FORCING_CHECKPOINT:-/path/to/causal_forcing.pt}"
export SELF_FORCING_MODEL_PATH="${SELF_FORCING_MODEL_PATH:-/path/to/Wan2.1-T2V-1.3B}"
export LONGCAT_MODEL_PATH="${LONGCAT_MODEL_PATH:-/path/to/LongCat-Video}"
